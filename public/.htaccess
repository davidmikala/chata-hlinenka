Options -Indexes
RewriteEngine On

# Vzdy HTTPS a jedina verejna domena.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.chatahlinenka\.cz$ [NC]
RewriteRule ^ https://www.chatahlinenka.cz%{REQUEST_URI} [R=301,L,NE]

# Stare neveřejné nahledove soubory a jednorazove testy nesmi byt dostupne,
# ani kdyby je FTP na serveru po aktualizaci omylem ponechalo.
RewriteRule ^(preview\.php|probe\.php|api/probe\.php)$ - [G,L,NC]

# PHP rezervace se vykonaji na serveru; nikdy nesmi byt presmerovany do SPA.
RewriteRule ^api/ - [L]

# Stavajici soubory a adresare obslouzi Apache.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Ostatni cesty (vcetne ubytovacich podminek) zpracuje React web.
RewriteRule ^ index.html [L]
